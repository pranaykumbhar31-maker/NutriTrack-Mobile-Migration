# ==============================================================================
# NutriTrack AI — Complete Environment Variable Template
# For Next.js Web/Backend, Python Scanner Service, and React Native / Expo Mobile
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Next.js App / Web Server Environment (.env.local in nutritrack-app)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="NutriTrack AI"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Standalone Python Scanner Service Proxy (Server-Only; NEVER prefix with NEXT_PUBLIC_)
# Local development default: http://127.0.0.1:8001
# Production: e.g. https://scanner.your-domain.com or https://nutritrack-scanner.onrender.com
SCANNER_URL=http://127.0.0.1:8001

# Optional shared secret header (matches SCANNER_API_KEY in nutritrack-scanner)
SCANNER_API_KEY=

# Groq Cloud Vision & Assistant API (Optional; fallback deterministic coach activates if blank)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Supabase PostgreSQL Persistence (Optional; local reactive JSON mode activates if blank)
NEXT_PUBLIC_SUPABASE_URL=https://placeholder.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=placeholder-anon-key


# ------------------------------------------------------------------------------
# 2. Standalone Python Scanner Service (.env in nutritrack-scanner)
# ------------------------------------------------------------------------------
# Backend choice: clip_zero_shot (instant OpenCLIP ViT-B-32) | onnx (custom trained weights)
SCANNER_BACKEND=clip_zero_shot

# Allowed CORS origins (comma-separated)
SCANNER_CORS_ORIGINS=http://localhost:3000,http://localhost:3001,https://nutritrack-app-beryl-five.vercel.app

# Optional secret key required in X-API-Key header
# SCANNER_API_KEY=

# Upload Limits & Quality
SCANNER_MAX_UPLOAD_BYTES=8388608
SCANNER_THRESHOLDS_CALIBRATED=false


# ------------------------------------------------------------------------------
# 3. React Native / Expo Mobile App (.env in expo mobile project)
# ------------------------------------------------------------------------------
# Note: For Android Emulator, use http://10.0.2.2:3000
#       For iOS Simulator, use http://localhost:3000
#       For Physical Device / Expo Go, use your machine's LAN IP: http://192.168.x.x:3000
#       For Production Build, use your deployed Vercel URL: https://nutritrack-app-beryl-five.vercel.app
EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_APP_NAME="NutriTrack AI"

# Optional direct Supabase client credentials in mobile app (if using direct client sync)
EXPO_PUBLIC_SUPABASE_URL=https://placeholder.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=placeholder-anon-key
